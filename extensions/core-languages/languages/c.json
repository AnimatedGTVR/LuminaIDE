{
  "id": "c",
  "name": "C",
  "extensions": [
    ".c",
    ".h"
  ],
  "lineComments": [
    "//"
  ],
  "blockComments": [
    [
      "/*",
      "*/"
    ]
  ],
  "strings": [
    "\""
  ],
  "preprocessor": true,
  "keywords": [
    "typedef",
    "struct",
    "union",
    "enum",
    "static",
    "extern",
    "const",
    "volatile",
    "register",
    "inline",
    "sizeof",
    "unsigned",
    "signed"
  ],
  "control": [
    "if",
    "else",
    "for",
    "while",
    "do",
    "switch",
    "case",
    "default",
    "return",
    "break",
    "continue",
    "goto"
  ],
  "types": [
    "int",
    "char",
    "short",
    "long",
    "float",
    "double",
    "void",
    "bool",
    "size_t",
    "uint8_t",
    "uint16_t",
    "uint32_t",
    "uint64_t",
    "int8_t",
    "int16_t",
    "int32_t",
    "int64_t",
    "FILE"
  ],
  "constants": [
    "NULL",
    "true",
    "false"
  ],
  "definitionKeywords": [
    "struct",
    "union",
    "enum"
  ],
  "run": "cc {file} -o /tmp/lumina-run-{name} && /tmp/lumina-run-{name}",
  "runWindows": ""
}
