{
  "id": "ini",
  "name": "INI / Config",
  "extensions": [
    ".ini",
    ".cfg",
    ".conf",
    ".editorconfig",
    ".gitconfig",
    ".desktop",
    ".service",
    ".socket",
    ".timer"
  ],
  "constants": [
    "true",
    "false",
    "yes",
    "no",
    "on",
    "off"
  ],
  "filenames": [
    ".editorconfig",
    ".gitconfig"
  ],
  "lineComments": [
