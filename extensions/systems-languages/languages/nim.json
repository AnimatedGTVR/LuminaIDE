    "proc",
    "func",
    "method",
    "iterator",
    "template",
    "macro",
    "converter",
    "type",
    "var",
    "let",
    "const",
    "import",
    "from",
    "include",
    "export",
    "as",
    "when",
    "of",
    "object",
    "tuple",
    "enum",
    "ref",
    "ptr",
    "distinct",
    "concept",
    "mixin",
    "bind",
    "using",
    "static"
  ],
  "control": [
    "if",
    "elif",
    "else",
    "case",
    "for",
    "while",
    "block",
    "break",
    "continue",
    "return",
    "yield",
    "discard",
    "try",
    "except",
    "finally",
    "raise",
    "defer",
    "in",
    "notin",
    "is",
    "isnot",
    "and",
    "or",
