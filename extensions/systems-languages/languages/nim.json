    "int16",
    "int32",
    "int64",
    "uint",
    "uint8",
    "uint16",
    "uint32",
    "uint64",
    "float",
    "float32",
    "float64",
    "bool",
    "char",
    "string",
    "seq",
    "array",
    "set",
    "cstring",
    "void",
    "auto"
  ],
  "constants": [
