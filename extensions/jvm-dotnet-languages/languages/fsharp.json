    "mutable",
    "rec",
    "and",
    "in",
    "do",
    "module",
    "namespace",
    "open",
    "type",
    "of",
    "fun",
    "function",
    "member",
    "abstract",
    "override",
    "interface",
    "inherit",
    "new",
    "val",
    "static",
    "private",
    "public",
    "internal",
    "inline",
    "lazy",
    "async",
    "use",
    "yield",
    "begin",
    "end",
    "done"
