<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LuminaIDE.AgentView">
  <Grid RowDefinitions="Auto,*,Auto">

    <StackPanel Grid.Row="0" Margin="14,12,10,6" Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="section" Text="AGENT" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
          <Border x:Name="NewChatButton" Classes="item" Padding="7,3"><TextBlock Classes="muted" FontSize="12" Text="New chat" /></Border>
          <Border x:Name="CloseButton" Classes="iconbtn" ToolTip.Tip="Close panel (Ctrl+Shift+A)"><Path Data="M6,6 L18,18 M18,6 L6,18" Width="10" Height="10" /></Border>
        </StackPanel>
      </Grid>
      <WrapPanel x:Name="AgentChips" />
      <WrapPanel x:Name="ModeChips" />
      <TextBlock x:Name="ModeHint" Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,4" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" x:Name="Scroll" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Transcript" Margin="14,6,14,12" Spacing="10" />
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="10,8,10,10">
      <StackPanel Spacing="6">
        <WrapPanel><Border x:Name="ContextChip" Classes="chip" Padding="10,3" Margin="0,0,0,0"><TextBlock x:Name="ContextText" FontSize="11" /></Border></WrapPanel>
        <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="180" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="StatusText" Classes="muted" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Border x:Name="SendButton" Grid.Column="1" Classes="btn" Padding="16,6"><TextBlock x:Name="SendText" Text="Send" /></Border>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
